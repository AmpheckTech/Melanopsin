@tokens {
    transparent: color = transparent;
    primary: color = #6750a4;
    on-surface: color = #1c1b1f;
    surface-variant: color = #e7e0ec;
}

Page {
    background: #fffbfe;
    color: $on-surface;
}

*:disabled { cursor: not-allowed; }

TextBlock {
    background: $transparent;
    color: $on-surface;
    font-size: 16fu;
    text-align: start;
    vertical-align: center;
}

Button {
    background: $primary;
    color: #ffffff;
    border-radius: 5ru;
    padding: 3su;
    font-size: 15fu;
    text-align: center;
    vertical-align: center;
    cursor: pointer;
    transition-duration: 3du;
    transition-easing: ease-in-out;
}

Button:hover { background: #7c66b3; }
Button:pressed { background: #58418f; }
Button:focused { border-color: $on-surface; border-width: 2hx; }
Button:disabled { opacity: 0.38; cursor: not-allowed; }

Badge {
    background: $surface-variant;
    color: $on-surface;
    border-radius: 3ru;
    padding: 2su;
    font-size: 14fu;
    text-align: center;
    vertical-align: center;
}

ListRow {
    background: $surface-variant;
    color: $on-surface;
    border-radius: 3ru;
    padding: 2su;
}

ScrollViewport {
    background: #f3edf7;
    border-color: #79747e;
    border-width: 1hx;
}

ScrollViewport::track { background: transparent; }

ScrollViewport::thumb {
    background: #79747e;
    border-radius: 1su;
    transition-duration: 120ms;
    transition-easing: ease-out;
}

ScrollViewport::thumb:hover { background: #938f99; }
ScrollViewport::thumb:pressed { background: #49454f; }

Panel { background: $transparent; padding: 0px; }

Input {
    background: #ffffff;
    color: $on-surface;
    border-color: #aab8b2;
    border-width: 1hx;
    border-radius: 2ru;
    padding: 2su;
    font-size: 15fu;
    cursor: text;
}

Input:focused { border-color: #27745f; border-width: 2hx; }
Input:disabled { cursor: not-allowed; }

NumberInput { background: transparent; padding: 0px; }
Button.number-input-step {
    background: #e3ece7;
    color: #245244;
    border-radius: 2ru;
    padding: 0px;
    font-size: 16fu;
}
Button.number-input-step:hover { background: #d5e4dc; }
Button.number-input-step:pressed { background: #c4d9cf; }

CheckBox, RadioButton, Switch {
    background: $transparent;
    color: $on-surface;
    padding: 1su;
    font-size: 15fu;
}

Option {
    background: $transparent;
    color: $on-surface;
    padding: 2su;
    font-size: 15fu;
}

ComboBox {
    background: #ffffff;
    color: $on-surface;
    border-color: #aab8b2;
    border-width: 1hx;
    border-radius: 2ru;
    padding: 2su;
    font-size: 15fu;
    cursor: pointer;
    transition-duration: 2du;
    transition-easing: ease-in-out;
}

ComboBox:hover { background: #f3f8f5; border-color: #6f9a8c; }
ComboBox:pressed { background: #e4eee8; }
ComboBox:expanded { border-color: #1f6d59; }
ComboBox:disabled {
    background: #f1f3f2;
    color: #6f7774;
    border-color: #c9cfcc;
    opacity: 0.6;
    cursor: not-allowed;
}

ComboBoxPopup {
    background: #ffffff;
    color: $on-surface;
    border-color: #b7c5bf;
    border-width: 1hx;
    border-radius: 2ru;
    padding: 2su;
    font-size: 15fu;
}

Slider { background: $transparent; padding: 2su; }
ProgressBar { background: $transparent; padding: 1su; }
Image { background: $surface-variant; border-radius: 3ru; }
Canvas { background: $transparent; }
TabControl { background: $transparent; padding: 0px; }
TabItem { background: $transparent; padding: 0px; }

Button.tab-button {
    background: #e3ece7;
    color: #405a51;
    border-radius: 2ru;
    padding: 1su;
    font-size: 13fu;
}

Button.tab-button:selected { background: #1f6d59; color: #ffffff; }
Separator { background: #c9d6d0; padding: 0px; }

Icon {
    background: $transparent;
    color: $on-surface;
    font-size: 18iu;
    text-align: center;
    vertical-align: center;
}

OverlayHost { background: $transparent; padding: 0px; }

Dialog {
    background: #fffbfe;
    color: $on-surface;
    border-color: #cac4d0;
    border-width: 1hx;
    border-radius: 6ru;
    padding: 5su;
}

.dialog-title { color: $on-surface; font-size: 22fu; padding: 1su; }
.dialog-message { color: #49454f; font-size: 15fu; padding: 2su; }
Button.dialog-button { background: #e8e0ec; color: $on-surface; border-radius: 3ru; font-size: 14fu; }
