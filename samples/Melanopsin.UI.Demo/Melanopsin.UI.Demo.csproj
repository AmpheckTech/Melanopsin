<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Background GC keeps segments committed after the managed heap shrinks.
         The demo is a small, idle-ish client, so blocking gen2 collections are
         short and the steadier resident set is worth it. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RootNamespace>Melanopsin.UI.Demo</RootNamespace>
    <!-- Some .NET 10 SDKs bundle Native AOT as Microsoft.DotNet.ILCompiler
         10.0.12, which NuGet audit reports as
         GHSA-p3jp-9v83-76w9. Directory.Build.props promotes warnings to errors, so that
         advisory fails `dotnet restore` for the whole solution. Pinning the patched
         compiler here is enough: the ILCompiler package realigns KnownILCompilerPack to
         the referenced version, so only the "explicit reference" warning needs muting. -->
    <SuppressGenerateILCompilerExplicitPackageReferenceWarning>true</SuppressGenerateILCompilerExplicitPackageReferenceWarning>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/UI/Melanopsin.UI.Desktop/Melanopsin.UI.Desktop.csproj" />
    <ProjectReference Include="../../src/UI/Melanopsin.UI/Melanopsin.UI.csproj" />
    <ProjectReference Include="../../src/UI/Melanopsin.UI.Controls/Melanopsin.UI.Controls.csproj" />
    <ProjectReference Include="../../src/UI/Melanopsin.UI.DevTools/Melanopsin.UI.DevTools.csproj" />
    <ProjectReference
      Include="../../src/UI/Melanopsin.UI.Markup.Compiler/Melanopsin.UI.Markup.Compiler.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      GlobalPropertiesToRemove="PublishAot;SelfContained;RuntimeIdentifier" />
    <ProjectReference Include="../../src/Melanopsin.Graphics.Backend/Melanopsin.Graphics.Backend.Skia/Melanopsin.Graphics.Backend.Skia.csproj" />
    <ProjectReference Include="..\..\src\UI\Melanopsin.UI.Platform\Melanopsin.UI.Platform.Win32\Melanopsin.UI.Platform.Win32.csproj" />
    <ProjectReference Include="..\..\src\UI\Melanopsin.UI.Platform\Melanopsin.UI.Platform.Wayland\Melanopsin.UI.Platform.Wayland.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Views/**/*.mxml" />
    <AdditionalFiles Include="Styles/**/*.mcss" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Melanopsin.Graphics" />
    <Using Include="Melanopsin.Graphics.Rendering" />
    <Using Include="Melanopsin.UI.Controls" />
    <Using Include="Melanopsin.UI.Layout" />
    <Using Include="Melanopsin.UI.Rendering" />
  </ItemGroup>

</Project>
