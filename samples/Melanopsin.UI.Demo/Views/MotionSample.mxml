<LinearLayout
  package="Melanopsin.UI.Demo.Views"
  component="MotionSample"
  orientation="vertical"
  spacing="0px"
  width="100%">
  <FlexLayout
    class="page-intro"
    direction="row"
    align-items="end"
    justify-content="space-between"
    column-gap="4su"
    width="100%"
    height="18su"
    flex-shrink="0">
    <FlexLayout
      class="intro-copy"
      direction="column"
      justify-content="end"
      row-gap="0.6su"
      width="0px"
      height="100%"
      flex-grow="1"
      flex-shrink="1">
      <TextBlock class="eyebrow" text="Motion" wrap="false" />
      <TextBlock class="page-title" text="Repaint boundary" wrap="false" />
      <TextBlock
        class="page-summary"
        text="A repeating tween moves behind a live backdrop-blur surface."
        wrap="false" />
    </FlexLayout>
    <FlexLayout
      class="run-info"
      direction="column"
      justify-content="end"
      align-items="end"
      row-gap="0.8su"
      width="27su"
      height="100%"
      flex-shrink="0">
      <TextBlock class="run-status" text="Playing · 720 ms" wrap="false" />
      <TextBlock class="run-note" text="Live retained tree" wrap="false" />
    </FlexLayout>
  </FlexLayout>

  <LinearLayout class="sample" orientation="vertical" spacing="0px" width="100%">
    <GridLayout
      class="motion-stage"
      columns="1"
      rows="1"
      width="100%"
      height="92su">
      <BouncingBall class="ball-stage" />
      <StackPanel class="glass-panel">
        <TextBlock class="glass-label" text="Backdrop blur" wrap="false" />
        <TextBlock class="glass-title" text="Live composite" wrap="false" />
        <TextBlock
          class="glass-detail"
          text="One value moves. Everything behind this surface stays live."
          width="100%" />
      </StackPanel>
    </GridLayout>
    <FlexLayout
      class="sample-footer"
      direction="row"
      align-items="center"
      justify-content="space-between"
      width="100%"
      height="9su">
      <FlexLayout
        class="playback-meta"
        direction="row"
        align-items="center"
        column-gap="1su"
        height="100%">
        <TextBlock class="playback-dot" text="●" wrap="false" />
        <TextBlock class="stage-meta" text="{{ MotionSpec }}" wrap="false" />
      </FlexLayout>
      <Button
        class="quiet-action"
        text="{{ DetailsButtonLabel }}"
        width="20su"
        height="5.8su"
        onClicked="ToggleDetails()" />
    </FlexLayout>
    @if (ShowDetails) {
      <FlexLayout
        class="detail"
        direction="row"
        align-items="start"
        column-gap="4su"
        width="100%">
        <TextBlock
          class="detail-title"
          text="Implementation"
          width="22su"
          flex-shrink="0"
          wrap="false" />
        <TextBlock class="detail-copy" text="{{ Message }}" width="0px" flex-grow="1" />
      </FlexLayout>
    }
  </LinearLayout>
</LinearLayout>
