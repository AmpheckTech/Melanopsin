<Page
  package="Melanopsin.UI.Demo.Views"
  component="MainView"
  title="Melanopsin UI Demo"
  class="app">
  <FlexLayout
    class="shell"
    direction="row"
    width="100%"
    height="100%">
    <LinearLayout
      class="rail"
      orientation="vertical"
      spacing="0px"
      width="27su"
      height="100%"
      flex-shrink="0">
      <FlexLayout
        class="rail-brand"
        direction="column"
        justify-content="end"
        row-gap="0.5su"
        width="100%"
        height="14su"
        flex-shrink="0">
        <TextBlock class="brand-name" text="Melanopsin" wrap="false" />
        <TextBlock class="rail-caption" text="Interface lab" wrap="false" />
      </FlexLayout>

      <LinearLayout
        class="rail-nav"
        orientation="vertical"
        spacing="0.7su"
        width="100%"
        weight="1">
        <TextBlock class="navigation-label" text="Samples" width="100%" wrap="false" />
        <Button
          class="{{ MotionTabClass }}"
          text="Motion"
          width="100%"
          height="7su"
          onClicked="SelectMotion()" />
        <Button
          class="{{ SceneTabClass }}"
          text="3D scene"
          width="100%"
          height="7su"
          onClicked="SelectScene()" />
        <Button
          class="{{ TypographyTabClass }}"
          text="Typography"
          width="100%"
          height="7su"
          onClicked="SelectTypography()" />
        <Button
          class="{{ LayoutTabClass }}"
          text="Layout"
          width="100%"
          height="7su"
          onClicked="SelectLayout()" />
        <Button
          class="{{ CodeTabClass }}"
          text="Markup"
          width="100%"
          height="7su"
          onClicked="SelectCode()" />
      </LinearLayout>

      <FlexLayout
        class="utility"
        direction="row"
        align-items="center"
        justify-content="start"
        column-gap="1su"
        width="100%"
        height="9su"
        flex-shrink="0">
        <TextBlock class="key" text="F12" width="6su" wrap="false" />
        <TextBlock class="utility-label" text="Inspect" width="9su" wrap="false" />
      </FlexLayout>
    </LinearLayout>

    <LinearLayout
      class="main"
      orientation="vertical"
      spacing="0px"
      width="0px"
      height="100%"
      flex-grow="1">
      <ScrollViewport axis="vertical" width="100%" weight="1">
        <LinearLayout
          class="page-content"
          orientation="vertical"
          spacing="0px"
          width="100%">
          @if (ShowMotion) {
            <MotionSample width="100%" />
          } @else if (ShowScene) {
            <SceneSample width="100%" />
          } @else if (ShowTypography) {
            <TypographySample width="100%" />
          } @else if (ShowLayout) {
            <LayoutSample width="100%" />
          } @else {
            <CodeSample width="100%" />
          }
        </LinearLayout>
      </ScrollViewport>
    </LinearLayout>
  </FlexLayout>
</Page>
