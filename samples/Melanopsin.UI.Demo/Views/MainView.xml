<Page
  xmlns:m="https://melanopsin.dev/schema"
  m:package="Melanopsin.UI.Demo.Views"
  m:class="MainView"
  title="Melanopsin UI Demo"
  class="app">
  <!-- This XML file is the MainView component template. -->
  <FlexLayout
    class="canvas"
    direction="row"
    align-items="center"
    justify-content="center"
    width="100%"
    height="100%">
    <StackPanel
      class="card"
      orientation="vertical"
      spacing="2su"
      width="86su">
      <FlexLayout
        class="header"
        direction="row"
        align-items="center"
        justify-content="space-between"
        height="13su">
        <StackPanel orientation="vertical" spacing="1su" flex-grow="1">
          <TextBlock class="eyebrow">MELANOPSIN UI</TextBlock>
          <TextBlock class="title">Markup playground</TextBlock>
        </StackPanel>
        <Badge class="state" Ref="StateBadge" text="Ready" width="17su" />
      </FlexLayout>

      <TextBlock class="intro">
        One component and one XML template. Edit this profile to see bindings
        and control-flow blocks update the preview.
      </TextBlock>

      <TextBlock class="label">Name</TextBlock>
      <Input
        Ref="NameInput"
        class="field"
        text="{{ Name }}"
        placeholder="Your name"
        max-length="40"
        height="10su" />

      <TextBlock class="label">Theme</TextBlock>
      <ComboBox
        Ref="ThemeSelect"
        class="field"
        selected-index="{{ ThemeIndex }}"
        height="10su">
        <Option text="Forest" value="forest" />
        <Option text="Ocean" value="ocean" />
        <Option text="Sunset" value="sunset" />
      </ComboBox>

      <FlexLayout
        direction="row"
        justify-content="space-between"
        align-items="center"
        height="5su">
        <TextBlock class="label">Accent strength</TextBlock>
        <TextBlock class="value" Ref="ToneValue" text="64%" />
      </FlexLayout>
      <Slider
        Ref="ToneSlider"
        minimum="0"
        maximum="100"
        step="1"
        value="{{ Tone }}"
        height="8su" />
      <ProgressBar
        Ref="PreviewProgress"
        value="64"
        maximum="100"
        height="2su" />

      <CheckBox
        Ref="DetailsCheck"
        text="Show details"
        checked="{{ ShowDetails }}"
        height="8su" />

      <StackPanel
        class="preview"
        orientation="vertical"
        spacing="2su">
        <TextBlock
          class="preview-title"
          Ref="PreviewText"
          text="{{ Greeting }}" />
        <TextBlock
          class="preview-detail"
          Ref="DetailsText"
          text="{{ ThemeSummary }}" />

        @switch (Theme) {
          @case ("Forest") {
            <TextBlock class="theme-note">A calm, natural palette.</TextBlock>
          }
          @case ("Ocean") {
            <TextBlock class="theme-note">A cool, focused palette.</TextBlock>
          }
          @case ("Sunset") {
            <TextBlock class="theme-note">A warm, expressive palette.</TextBlock>
          }
          @default {
            <TextBlock class="theme-note">Choose a theme.</TextBlock>
          }
        }

        @if (ShowDetails) {
          <FlexLayout
            class="tags"
            direction="row"
            wrap="wrap"
            column-gap="1su"
            row-gap="1su">
            @for (tag of Tags; track tag) {
              <Badge class="tag" text="{{ tag }}" />
            } @empty {
              <TextBlock class="preview-detail">No tags yet.</TextBlock>
            }
          </FlexLayout>
        } @else {
          <TextBlock class="preview-detail">Details are hidden.</TextBlock>
        }
      </StackPanel>

      <Button
        Ref="ApplyButton"
        class="primary"
        text="Apply settings"
        height="10su" />
    </StackPanel>
  </FlexLayout>
</Page>
