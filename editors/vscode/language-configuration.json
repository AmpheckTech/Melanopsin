{
  "comments": {
    "blockComment": [
      "<!--",
      "-->"
    ]
  },
  "brackets": [
    [
      "<",
      ">"
    ],
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "<!--",
      "close": "-->"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "comment",
        "string"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "comment",
        "string"
      ]
    },
    {
      "open": "{{",
      "close": "}}"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    }
  ],
  "surroundingPairs": [
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "wordPattern": "(-?\\d*\\.?\\d+\\w*)|([@A-Za-z_][A-Za-z0-9_.:-]*)"
}
