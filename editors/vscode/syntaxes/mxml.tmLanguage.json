{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Melanopsin MXML",
  "scopeName": "source.mxml",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#processing-instruction"
    },
    {
      "include": "#cdata"
    },
    {
      "include": "#code-block"
    },
    {
      "include": "#directive-condition"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#closing-tag"
    },
    {
      "include": "#opening-tag"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#escaped-at"
    },
    {
      "include": "#entity"
    }
  ],
  "repository": {
    "comment": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block.mxml"
    },
    "processing-instruction": {
      "begin": "<\\?",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.processing-instruction.begin.mxml"
        }
      },
      "end": "\\?>",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.processing-instruction.end.mxml"
        }
      },
      "name": "meta.tag.preprocessor.mxml"
    },
    "cdata": {
      "begin": "<!\\[CDATA\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.cdata.begin.mxml"
        }
      },
      "end": "\\]\\]>",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.cdata.end.mxml"
        }
      },
      "name": "string.unquoted.cdata.mxml"
    },
    "directive-condition": {
      "begin": "(@)(if|else\\s+if|for|switch|case)\\b(\\s*)(\\()",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.directive.mxml"
        },
        "2": {
          "name": "keyword.control.conditional.mxml"
        },
        "4": {
          "name": "punctuation.section.parens.begin.mxml"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.mxml"
        }
      },
      "contentName": "meta.embedded.line.cs",
      "patterns": [
        {
          "include": "#csharp-expression"
        }
      ]
    },
    "directive": {
      "match": "(@)(if|else\\s+if|else|for|empty|switch|case|default)\\b",
      "captures": {
        "1": {
          "name": "punctuation.definition.directive.mxml"
        },
        "2": {
          "name": "keyword.control.conditional.mxml"
        }
      }
    },
    "escaped-at": {
      "match": "@@",
      "name": "constant.character.escape.mxml"
    },
    "entity": {
      "match": "&(?:#[0-9]+|#x[0-9A-Fa-f]+|[A-Za-z][A-Za-z0-9]+);",
      "name": "constant.character.entity.mxml"
    },
    "interpolation": {
      "begin": "\\{\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.mxml"
        }
      },
      "end": "\\}\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.mxml"
        }
      },
      "contentName": "meta.embedded.line.cs",
      "patterns": [
        {
          "include": "#csharp-expression"
        }
      ]
    },
    "csharp-expression": {
      "patterns": [
        {
          "include": "source.cs"
        },
        {
          "match": "\\b(?:true|false|null)\\b",
          "name": "constant.language.cs"
        },
        {
          "match": "\\b(?:new|is|as|typeof|nameof|default)\\b",
          "name": "keyword.operator.expression.cs"
        },
        {
          "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?[fFdDmMuUlL]*\\b",
          "name": "constant.numeric.cs"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "variable.other.cs"
        },
        {
          "match": "(?:==|!=|<=|>=|=>|&&|\\|\\||\\?\\?|[+\\-*/%<>!?:=])",
          "name": "keyword.operator.cs"
        },
        {
          "match": "[.,]",
          "name": "punctuation.separator.cs"
        }
      ]
    },
    "closing-tag": {
      "match": "(</)([A-Za-z_][A-Za-z0-9_.:-]*)(\\s*)(/?>)",
      "name": "meta.tag.mxml",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.mxml"
        },
        "2": {
          "name": "entity.name.tag.mxml"
        },
        "4": {
          "name": "punctuation.definition.tag.end.mxml"
        }
      }
    },
    "opening-tag": {
      "begin": "(<)([A-Za-z_][A-Za-z0-9_.:-]*)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.mxml"
        },
        "2": {
          "name": "entity.name.tag.mxml"
        }
      },
      "end": "(/?>)",
      "name": "meta.tag.mxml",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.mxml"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#event-attribute-value"
        },
        {
          "include": "#event-attribute"
        },
        {
          "include": "#quoted-attribute"
        },
        {
          "include": "#unquoted-attribute"
        },
        {
          "include": "#incomplete-attribute"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "event-attribute": {
      "match": "(on[A-Z][A-Za-z0-9_]*)(?=\\s*=)",
      "name": "entity.other.attribute-name.event.mxml"
    },
    "quoted-attribute": {
      "begin": "([A-Za-z_][A-Za-z0-9_.:-]*)(\\s*)(=)(\\s*)([\"'])",
      "name": "meta.attribute.mxml",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.mxml"
        },
        "3": {
          "name": "keyword.operator.assignment.mxml"
        },
        "5": {
          "name": "punctuation.definition.string.begin.mxml"
        }
      },
      "end": "\\5",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.mxml"
        }
      },
      "contentName": "string.quoted.mxml",
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "#entity"
        }
      ]
    },
    "unquoted-attribute": {
      "match": "([A-Za-z_][A-Za-z0-9_.:-]*)(\\s*)(=)(\\s*)([^\\s/>]+)",
      "name": "meta.attribute.mxml",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.mxml"
        },
        "3": {
          "name": "keyword.operator.assignment.mxml"
        },
        "5": {
          "name": "string.unquoted.mxml"
        }
      }
    },
    "incomplete-attribute": {
      "match": "[A-Za-z_][A-Za-z0-9_.:-]*(?=\\s|$)",
      "name": "entity.other.attribute-name.mxml"
    },
    "event-attribute-value": {
      "begin": "(on[A-Z][A-Za-z0-9_]*)(\\s*)(=)(\\s*)([\"'])",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.event.mxml"
        },
        "3": {
          "name": "keyword.operator.assignment.mxml"
        },
        "5": {
          "name": "punctuation.definition.string.begin.mxml"
        }
      },
      "end": "\\5",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.mxml"
        }
      },
      "name": "meta.attribute.event.mxml",
      "contentName": "meta.embedded.line.cs",
      "patterns": [
        {
          "include": "#csharp-expression"
        }
      ]
    },
    "code-block": {
      "begin": "(@)(code)\\b(\\s*)(\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.directive.mxml"
        },
        "2": {
          "name": "keyword.control.directive.mxml"
        },
        "4": {
          "name": "punctuation.section.block.begin.mxml"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.block.end.mxml"
        }
      },
      "contentName": "meta.embedded.block.cs",
      "patterns": [
        {
          "include": "#code-body"
        },
        {
          "include": "#csharp-expression"
        }
      ]
    },
    "code-body": {
      "begin": "\\{",
      "end": "\\}",
      "contentName": "meta.embedded.block.cs",
      "patterns": [
        {
          "include": "#code-body"
        },
        {
          "include": "#csharp-expression"
        }
      ]
    }
  }
}
