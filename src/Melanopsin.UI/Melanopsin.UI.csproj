<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>Melanopsin.UI</RootNamespace>
    <Description>Native AOT-friendly UI runtime for desktop and embedded applications.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Melanopsin.Mathematics/Melanopsin.Mathematics.csproj" />
    <ProjectReference Include="../Melanopsin.Reactive/Melanopsin.Reactive.csproj" />
    <ProjectReference Include="../Melanopsin.Graphics/Melanopsin.Graphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Melanopsin.UI.Animation" />
    <Using Include="Melanopsin.Mathematics" />
    <Using Include="Melanopsin.Reactive" />
    <Using Include="Melanopsin.Graphics" />
    <Using Include="Melanopsin.Graphics.Text.Fonts" />
    <Using Include="Melanopsin.Graphics.Text" />
    <Using Include="Melanopsin.Graphics.Rendering" />
    <Using Include="Melanopsin.UI.Hosting" />
    <Using Include="Melanopsin.UI.Layout" />
  </ItemGroup>
</Project>
