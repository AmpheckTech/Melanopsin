<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageTags>ui;graphics;skia;rendering</PackageTags>
    <RootNamespace>Melanopsin.Graphics.Backend.Skia</RootNamespace>
    <Description>Default Skia rendering backend for Melanopsin.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Melanopsin.Graphics/Melanopsin.Graphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Melanopsin.Mathematics" />
    <Using Include="Melanopsin.Graphics" />
    <Using Include="Melanopsin.Graphics.Text.Fonts" />
    <Using Include="Melanopsin.Graphics.Rendering" />
  </ItemGroup>
</Project>
