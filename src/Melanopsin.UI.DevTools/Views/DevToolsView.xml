<Page
  xmlns:m="https://melanopsin.dev/schema"
  m:package="Melanopsin.UI.DevTools"
  m:class="DevToolsComponent"
  title="Melanopsin DevTools"
  class="devtools-root">
  <LinearLayout orientation="vertical" spacing="2su" width="100%" height="100%">
    <FlexLayout
      class="devtools-header"
      direction="row"
      align-items="center"
      justify-content="space-between"
      height="10su">
      <TextBlock class="devtools-title">MELANOPSIN DEVTOOLS</TextBlock>
      <TextBlock class="devtools-caption">Window inspector</TextBlock>
    </FlexLayout>

    <FlexLayout
      class="devtools-tabs"
      direction="row"
      wrap="wrap"
      column-gap="1su"
      row-gap="1su"
      min-height="10su">
      @for (window of Windows; track window.Id) {
        <Button
          class="{{ window.CssClass }}"
          text="{{ window.Title }}"
          height="8su"
          flex-grow="1" />
      }
    </FlexLayout>

    <ScrollViewport
      class="devtools-scroll"
      axis="vertical"
      width="100%"
      weight="1">
      <LinearLayout class="devtools-content" orientation="vertical" spacing="1su" width="100%">
        <TextBlock id="devtools-section" class="devtools-section">SELECTED WINDOW</TextBlock>
        <TextBlock id="devtools-selected" class="devtools-selected">{{ SelectedTitle }}</TextBlock>
        <TextBlock id="devtools-frame" class="devtools-value">{{ FrameText }}</TextBlock>
        <TextBlock id="devtools-layout" class="devtools-value">{{ LayoutText }}</TextBlock>
        <TextBlock id="devtools-compose" class="devtools-value">{{ ComposeText }}</TextBlock>
        <TextBlock id="devtools-render" class="devtools-value">{{ RenderText }}</TextBlock>
        <TextBlock id="devtools-damage" class="devtools-value">{{ DamageText }}</TextBlock>
        <TextBlock id="devtools-paint-cache" class="devtools-value">{{ PaintCacheText }}</TextBlock>
        <TextBlock id="devtools-relayout-cache" class="devtools-value">{{ RelayoutCacheText }}</TextBlock>
        <TextBlock id="devtools-vision" class="devtools-value">{{ VisionText }}</TextBlock>
        <TextBlock class="devtools-hint">
          Tabs select a Window. Shortcuts are defined by the host application.
        </TextBlock>
      </LinearLayout>
    </ScrollViewport>
  </LinearLayout>
</Page>
