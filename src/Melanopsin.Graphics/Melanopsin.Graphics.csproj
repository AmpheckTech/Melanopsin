<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageTags>ui;graphics;text;font;shaping</PackageTags>
    <RootNamespace>Melanopsin.Graphics</RootNamespace>
    <Description>Backend-neutral graphics geometry, commands, surfaces, font parsing, shaping, and text layout.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../external/Melanopsin.Mathematics/Melanopsin.Mathematics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp" Version="14.2.1.301" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.301" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.2.1.301" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Melanopsin.Mathematics" />
    <Using Include="Melanopsin.Graphics.Text.Fonts" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Text/Shaping/LineBreakData.bin">
      <LogicalName>Melanopsin.Graphics.Text.Shaping.LineBreakData.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Text/Shaping/BidiData.bin">
      <LogicalName>Melanopsin.Graphics.Text.Shaping.BidiData.bin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
