<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>Melanopsin.Graphics</RootNamespace>
    <Description>Backend-neutral graphics geometry, commands, surfaces, font parsing, shaping, and text layout.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Melanopsin.Mathematics/Melanopsin.Mathematics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp" Version="14.2.1.301" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.301" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.2.1.301" />
    <PackageReference Include="Unicode.Bidi" Version="0.3.18" />
    <PackageReference Include="Uax14Net" Version="1.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Melanopsin.Mathematics" />
    <Using Include="Melanopsin.Graphics.Text.Fonts" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
