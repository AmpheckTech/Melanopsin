<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(MelanopsinResourceCompilerTargetFramework)</TargetFramework>
    <AssemblyName>Melanopsin.UI.ResourceCompiler</AssemblyName>
    <RootNamespace>Melanopsin.UI.ResourceCompiler</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <ProjectReference Include="../../src/Melanopsin.UI/Melanopsin.UI.csproj" />
    <ProjectReference Include="../../src/Melanopsin.Graphics/Melanopsin.Graphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework">
      <HintPath>$(MSBuildToolsPath)/Microsoft.Build.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Build.Utilities.Core">
      <HintPath>$(MSBuildToolsPath)/Microsoft.Build.Utilities.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
